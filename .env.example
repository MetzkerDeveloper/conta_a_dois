# Copie para .env.local. Nunca versionar credenciais reais.
# URL pooled do Neon para a aplicação; use sslmode=verify-full.
DATABASE_URL=
# URL direta (sem pooler) para migrations manuais.
DATABASE_URL_UNPOOLED=
# Gere com: openssl rand -base64 48
AUTH_SECRET=
# http://localhost:3000 no desenvolvimento; https://seu-dominio em produção.
AUTH_URL=http://localhost:3000
RESEND_API_KEY=
# Remetente verificado no Resend: Contas a Dois <acesso@seu-dominio>
RESEND_FROM=
# Somente testes isolados; nunca apontar para banco com dados reais.
TEST_DATABASE_URL=
